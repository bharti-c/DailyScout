# DailyScout Environment Variables Template
# Copy this file to .env and insert your real credentials.
# NEVER commit your real .env file to version control.

# Google Gemini API Key (Required for live scout with Google Search grounding)
# Obtain at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB Atlas Connection URI (Required for Stage 2 & Stage 3 persistence)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_connection_uri_here

# JWT Secret Key (Required for signing tokens in Stage 2 & Stage 3)
# Generate a strong 32+ character random secret (e.g. `openssl rand -hex 32`)
JWT_SECRET=your_jwt_secret_random_key_here

# Resend Email API Key (Required for Stage 3 email delivery)
# Obtain at: https://resend.com/
EMAIL_API_KEY=your_resend_api_key_here

# Sender Email Address (Required for Stage 3)
# Must be a verified domain in Resend or onboarding@resend.dev for testing
SENDER_EMAIL=DailyScout <onboarding@resend.dev>

# Pexels API Key (Optional: used for fallback article imagery when og:image is missing)
# Obtain at: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# Frontend Application URL (Used for CORS and email links)
FRONTEND_URL=http://localhost:8000
